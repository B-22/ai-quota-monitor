<?xml version="1.0" encoding="utf-8"?>
<!--
    1×1 小组件的重置卡到期提醒图标，24dp 视口、描边式画法。
    描边用白色，由 Glance 的 Image colorFilter 按语气色（琥珀 / 红）着色，
    所以这个 drawable 本身不带任何颜色，深浅主题共用同一份。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 闹钟铃铛 -->
    <path
        android:pathData="M5.6,3.2 L3.2,1.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M18.4,3.2 L20.8,1.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- 表盘 -->
    <path
        android:pathData="M20.5,13 A8.5,8.5 0 1 1 3.5,13 A8.5,8.5 0 1 1 20.5,13 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />

    <!-- 指针：停在「将要到期」的位置上 -->
    <path
        android:pathData="M12,8.8 L12,13.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,13.2 L15.1,15"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>