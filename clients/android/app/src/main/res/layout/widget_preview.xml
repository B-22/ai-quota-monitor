<?xml version="1.0" encoding="utf-8"?>
<!--
    单账号小组件的静态预览：深色卡片 + 双环占位 + 1×1 那两行文字。
    画不出圆环进度，用两个同心圆示意，位置与配色跟随设计稿。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="110dp"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:text="◎"
            android:textColor="#FF2A2E36"
            android:textSize="60sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="5h"
                android:textColor="#FF9AA0A8"
                android:textSize="7sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="5 小时剩余 62%"
                android:includeFontPadding="false"
                android:text="62%"
                android:textColor="#FFF2F3F5"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="↻2h13"
                android:textColor="#FFC9CDD3"
                android:textSize="8sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="7d  48%  ↻3d5h"
        android:textColor="#FF9AA0A8"
        android:textSize="9sp" />
</LinearLayout>
